# ============================================================# JDCloud RE-SS-01 (IPQ6018) ImmortalWrt 25.12 固件配置# 无线信号优化版 - 含 iStore 应用商店 + Docker + Argon 主题 + OPKG# ============================================================
# ---- 目标设备 ----CONFIG_TARGET_qualcommax=yCONFIG_TARGET_qualcommax_ipq60xx=yCONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
# ---- 内核与基础 ----CONFIG_KERNEL_BUILD_DOMAIN=""CONFIG_KERNEL_BUILD_USER=""CONFIG_TARGET_ROOTFS_SQUASHFS=y
# ---- LuCI 基础 ----CONFIG_LUCI_LANG_zh_Hans=yCONFIG_PACKAGE_luci=yCONFIG_PACKAGE_luci-compat=yCONFIG_PACKAGE_luci-base=yCONFIG_PACKAGE_luci-mod-admin-full=yCONFIG_PACKAGE_luci-proto-ipv6=yCONFIG_PACKAGE_luci-proto-ppp=yCONFIG_PACKAGE_luci-theme-argon=y
# ---- IPv6 服务器（odhcpd：LAN 侧 RA/DHCPv6，配合 network 的 wan6 实现 IPv6 获取与下发）----CONFIG_PACKAGE_odhcpd=y# ---- iStore 应用商店 (luci-app-store) ----CONFIG_PACKAGE_luci-app-store=yCONFIG_PACKAGE_istore=yCONFIG_PACKAGE_istore-luci=y
# ---- 无线驱动与固件（信号优化核心）----CONFIG_PACKAGE_kmod-ath11k=yCONFIG_PACKAGE_kmod-ath11k-pci=yCONFIG_PACKAGE_ath11k-firmware-ipq6018=yCONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=yCONFIG_PACKAGE_kmod-mac80211=yCONFIG_PACKAGE_kmod-cfg80211=y
# ---- 常用网络工具 ----CONFIG_PACKAGE_wireless-tools=yCONFIG_PACKAGE_iw=yCONFIG_PACKAGE_iwinfo=yCONFIG_PACKAGE_etherwake=yCONFIG_PACKAGE_arp=yCONFIG_PACKAGE_tcpdump=yCONFIG_PACKAGE_wget-ssl=yCONFIG_PACKAGE_curl=y
# ---- 常用插件 ----CONFIG_PACKAGE_luci-app-firewall=yCONFIG_PACKAGE_luci-app-ttyd=yCONFIG_PACKAGE_luci-app-upnp=yCONFIG_PACKAGE_luci-app-sqm=yCONFIG_PACKAGE_luci-app-watchcat=y
# ---- 包管理器：使用 OPKG（禁用 APK，ImmortalWrt 默认 APK 需显式切回）----CONFIG_USE_APK=nCONFIG_PACKAGE_opkg=yCONFIG_PACKAGE_apk-mbedtls=n
# ---- 其他实用工具 ----CONFIG_PACKAGE_luci-app-opkg=yCONFIG_PACKAGE_htop=yCONFIG_PACKAGE_lsof=yCONFIG_PACKAGE_nano=yCONFIG_PACKAGE_ca-bundle=y
# ---- Docker 容器环境（dockerman 面板 + dockerd + CLI + compose）----CONFIG_PACKAGE_dockerd=yCONFIG_PACKAGE_docker=yCONFIG_PACKAGE_docker-compose=yCONFIG_PACKAGE_luci-app-dockerman=yCONFIG_PACKAGE_luci-lib-docker=y
# 容器网络与防火墙内核模块（dockerd 运行时依赖，显式补齐避免缺包）CONFIG_PACKAGE_kmod-veth=yCONFIG_PACKAGE_kmod-br-netfilter=yCONFIG_PACKAGE_kmod-ipt-nat=yCONFIG_PACKAGE_kmod-ipt-nat6=yCONFIG_PACKAGE_kmod-ipt-physdev=yCONFIG_PACKAGE_kmod-nf-ipvs=yCONFIG_PACKAGE_kmod-nf-nat=yCONFIG_PACKAGE_iptables-mod-extra=yCONFIG_PACKAGE_libseccomp=y
# ---- 内核资源隔离 cgroup/namespace（内核支持则生效；不支持 defconfig 自动忽略，不致编译失败）----CONFIG_KERNEL_CGROUPS=yCONFIG_KERNEL_CGROUP_PIDS=yCONFIG_KERNEL_CGROUP_BPF=yCONFIG_KERNEL_CPUSETS=yCONFIG_KERNEL_CGROUP_CPUACCT=yCONFIG_KERNEL_MEMCG=yCONFIG_KERNEL_NAMESPACES=yCONFIG_KERNEL_UTS_NS=yCONFIG_KERNEL_IPC_NS=yCONFIG_KERNEL_PID_NS=yCONFIG_KERNEL_NET_NS=yCONFIG_KERNEL_SECCOMP_FILTER=y
