# ============================================================
# JDCloud RE-SS-01 (IPQ6018) ImmortalWrt 25.12 固件配置
# 无线信号优化版 - 含 iStore 应用商店
# ============================================================

# ---- 目标设备 ----
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y

# ---- 内核与基础 ----
CONFIG_KERNEL_BUILD_DOMAIN=""
CONFIG_KERNEL_BUILD_USER=""
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# ---- LuCI 基础 ----
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y

# ---- iStore 应用商店 (luci-app-store) ----
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_istore=y
CONFIG_PACKAGE_istore-luci=y

# ---- 无线驱动与固件（信号优化核心）----
CONFIG_PACKAGE_kmod-ath11k=y
CONFIG_PACKAGE_kmod-ath11k-pci=y
CONFIG_PACKAGE_ath11k-firmware-ipq6018=y
CONFIG_PACKAGE_ipq-wifi-jdcloud_re-ss-01=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y

# ---- 常用网络工具 ----
CONFIG_PACKAGE_wireless-tools=y
CONFIG_PACKAGE_iw=y
CONFIG_PACKAGE_iwinfo=y
CONFIG_PACKAGE_etherwake=y
CONFIG_PACKAGE_arp=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_curl=y

# ---- 常用插件 ----
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_luci-app-sqm=y
CONFIG_PACKAGE_luci-app-watchcat=y

# ---- 其他实用工具 ----
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_luci-app-opkg=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_ca-bundle=y

# ---- Docker 容器环境（dockerman 面板 + dockerd + CLI + compose）----
CONFIG_PACKAGE_dockerd=y
CONFIG_PACKAGE_docker=y
CONFIG_PACKAGE_docker-compose=y
CONFIG_PACKAGE_luci-app-dockerman=y
CONFIG_PACKAGE_luci-lib-docker=y

# 容器网络与防火墙内核模块（dockerd 运行时依赖，显式补齐避免缺包）
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_kmod-br-netfilter=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_kmod-ipt-physdev=y
CONFIG_PACKAGE_kmod-nf-ipvs=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_libseccomp=y

# ---- 内核资源隔离 cgroup/namespace（内核支持则生效；不支持 defconfig 自动忽略，不致编译失败）----
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_PIDS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_CPUSETS=y
CONFIG_KERNEL_CGROUP_CPUACCT=y
CONFIG_KERNEL_MEMCG=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_UTS_NS=y
CONFIG_KERNEL_IPC_NS=y
CONFIG_KERNEL_PID_NS=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_SECCOMP_FILTER=y
